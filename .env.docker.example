# ===========================================
# Configurações do Docker - sisptrab
# ===========================================
# Copie este arquivo para .env antes de executar docker-compose up

# Banco de Dados PostgreSQL
DB_USER=sisptrab
DB_PASSWORD=ALTERE_ESTA_SENHA_EM_PRODUCAO
DB_NAME=sisptrab
DB_PORT=5432

# Aplicação
# APP_URL: endereço pelo qual os computadores da rede acessam o sistema
# (IP ou hostname do servidor na LAN)
APP_PORT=3000
APP_URL=http://192.168.0.10:3000

# Segurança
# Gere um JWT_SECRET seguro com: openssl rand -base64 32
JWT_SECRET=ALTERE_ESTE_SECRET_EM_PRODUCAO

# Cookie de login:
# false = acesso por HTTP (intranet, padrão) | true = exige HTTPS
COOKIE_SECURE=false
