generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum AcaoAprovacao {
  APROVADO
  REPROVADO
}

enum ClasseDespesa {
  CLASSE_I
  CLASSE_II
  CLASSE_III
  CLASSE_IV
  CLASSE_V
  CLASSE_VI
  CLASSE_VII
  CLASSE_VIII
  CLASSE_IX
  CLASSE_X
}

enum Role {
  COMANDANTE
  S4
  INTEGRANTE
  SUPER_ADMIN
}

enum StatusPlano {
  RASCUNHO
  EM_ANALISE
  APROVADO
  REPROVADO
}

enum TipoEvento {
  CRIACAO
  ENVIO_ANALISE
  APROVACAO
  REPROVACAO
  EDICAO
}

enum TipoOM {
  COMPANHIA
  BATALHAO
  GRANDE_UNIDADE
  GRANDE_COMANDO
  COMANDO_MILITAR_DE_AREA
  ORGAO_DE_DIRECAO_SETORIAL
  ORGAO_DE_DIRECAO_GERAL
  OUTROS
}

enum TipoPlano {
  LOGISTICO
  OPERACIONAL_GND3
  OPERACIONAL_GND4
  RACAO_R2
  MUNICAO
}

enum SituacaoPregao {
  PARTICIPANTE
  ADESAO_CARONA
  DISPENSA
  INEXIGIBILIDADE
  OUTRO
}

// Models
model ArtigoConsulta {
  id        String   @id @default(cuid())
  titulo    String
  categoria String // "PREGAO" | "COMPRASNET" | "REGULAMENTO" | "OUTRO"
  conteudo  String   @db.Text // Markdown
  autorId   String   @map("autor_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  autor     User     @relation(fields: [autorId], references: [id])

  @@index([categoria])
  @@map("artigos_consulta")
}

model Anotacao {
  id              String        @id @default(cuid())
  conteudo        String
  etapaWorkflow   String        @map("etapa_workflow")
  planoTrabalhoId String        @map("plano_trabalho_id")
  autorId         String        @map("autor_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  autor           User          @relation(fields: [autorId], references: [id])
  planoTrabalho   PlanoTrabalho @relation(fields: [planoTrabalhoId], references: [id], onDelete: Cascade)

  @@index([autorId])
  @@index([planoTrabalhoId])
  @@map("anotacoes")
}

model AprovacaoHistorico {
  id               String             @id @default(cuid())
  acao             AcaoAprovacao
  motivo           String?
  nivelHierarquico Int                @map("nivel_hierarquico")
  planoTrabalhoId  String             @map("plano_trabalho_id")
  aprovadorId      String             @map("aprovador_id")
  omNivelId        String             @map("om_nivel_id")
  dataAcao         DateTime           @default(now()) @map("data_acao")
  createdAt        DateTime           @default(now()) @map("created_at")
  aprovador        User               @relation(fields: [aprovadorId], references: [id])
  planoTrabalho    PlanoTrabalho      @relation(fields: [planoTrabalhoId], references: [id], onDelete: Cascade)
  omNivel          OrganizacaoMilitar @relation(fields: [omNivelId], references: [id])

  @@index([aprovadorId])
  @@index([dataAcao])
  @@index([planoTrabalhoId])
  @@index([omNivelId])
  @@map("aprovacoes_historico")
}

model AuditoriaLog {
  id              String         @id @default(cuid())
  tipoEvento      TipoEvento     @map("tipo_evento")
  descricao       String
  metadados       Json?
  usuarioId       String?        @map("usuario_id")
  planoTrabalhoId String?        @map("plano_trabalho_id")
  operacaoId      String?        @map("operacao_id")
  timestamp       DateTime       @default(now())
  operacao        Operacao?      @relation(fields: [operacaoId], references: [id], onDelete: Cascade)
  planoTrabalho   PlanoTrabalho? @relation(fields: [planoTrabalhoId], references: [id], onDelete: Cascade)
  usuario         User?          @relation(fields: [usuarioId], references: [id])

  @@index([operacaoId])
  @@index([planoTrabalhoId])
  @@index([timestamp])
  @@index([tipoEvento])
  @@index([usuarioId])
  @@map("auditoria_logs")
}

model Classe {
  id                        String        @id @default(cuid())
  nome                      ClasseDespesa @unique
  descricao                 String
  gnd                       String        @default("GND 3")
  naturezasPermitidas       String[]
  possuiCalculoAutomatizado Boolean
  createdAt                 DateTime      @default(now()) @map("created_at")
  updatedAt                 DateTime      @updatedAt @map("updated_at")
  despesas                  Despesa[]
  tipos                     Tipo[]

  @@index([nome])
  @@map("classes")
}

model Despesa {
  id                     String            @id @default(cuid())
  descricao              String
  planoTrabalhoId        String            @map("plano_trabalho_id")
  classeId               String            @map("classe_id")
  tipoId                 String?           @map("tipo_id")
  parametros             Json
  valorCalculado         Decimal           @map("valor_calculado") @db.Decimal(15, 2)
  valorCombustivel       Decimal?          @map("valor_combustivel") @db.Decimal(15, 2)
  importado              Boolean           @default(false)
  valorImportadoOriginal Decimal?          @map("valor_importado_original") @db.Decimal(15, 2)
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  classe                 Classe            @relation(fields: [classeId], references: [id])
  planoTrabalho          PlanoTrabalho     @relation(fields: [planoTrabalhoId], references: [id], onDelete: Cascade)
  tipo                   Tipo?             @relation(fields: [tipoId], references: [id])
  oms                    DespesaOM[]
  despesasNaturezas      DespesaNatureza[]

  @@index([classeId])
  @@index([planoTrabalhoId])
  @@index([tipoId])
  @@map("despesas")
}

model DespesaOM {
  id             String             @id @default(cuid())
  despesaId      String             @map("despesa_id")
  omDestinoId    String             @map("om_id")
  omCompradoraId String             @map("om_compradora_id")
  percentual     Decimal            @db.Decimal(5, 2)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  despesa        Despesa            @relation(fields: [despesaId], references: [id], onDelete: Cascade)
  omDestino      OrganizacaoMilitar @relation("DespesaOMDestino", fields: [omDestinoId], references: [id])
  omCompradora   OrganizacaoMilitar @relation("DespesaOMCompradora", fields: [omCompradoraId], references: [id])

  @@index([despesaId])
  @@index([omDestinoId])
  @@index([omCompradoraId])
  @@map("despesas_om")
}

model DespesaNatureza {
  id         String          @id @default(cuid())
  despesaId  String          @map("despesa_id")
  naturezaId String          @map("natureza_id")
  percentual Decimal         @db.Decimal(5, 2)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  despesa    Despesa         @relation(fields: [despesaId], references: [id], onDelete: Cascade)
  natureza   NaturezaDespesa @relation(fields: [naturezaId], references: [id])

  @@unique([despesaId, naturezaId])
  @@index([despesaId])
  @@index([naturezaId])
  @@map("despesas_naturezas")
}

model DespesaOperacional {
  id               String                       @id @default(cuid())
  planoTrabalhoId  String                       @map("plano_trabalho_id")
  omDestinoId      String                       @map("om_id")
  omCompradoraId   String                       @map("om_compradora_id")
  titulo           String
  objeto           String?                      @db.Text
  objetivo         String?                      @db.Text
  finalidade       String?                      @db.Text
  memoriaCalculo   String                       @map("memoria_calculo") @db.Text
  pregaoUasg       String?                      @map("pregao_uasg")
  situacaoPregao   SituacaoPregao?              @map("situacao_pregao")
  observacaoPregao String?                      @map("observacao_pregao") @db.Text
  importado        Boolean                      @default(false)
  createdAt        DateTime                     @default(now()) @map("created_at")
  updatedAt        DateTime                     @updatedAt @map("updated_at")
  planoTrabalho    PlanoTrabalho                @relation(fields: [planoTrabalhoId], references: [id], onDelete: Cascade)
  omDestino        OrganizacaoMilitar           @relation("DespesaOperacionalDestino", fields: [omDestinoId], references: [id])
  omCompradora     OrganizacaoMilitar           @relation("DespesaOperacionalCompradora", fields: [omCompradoraId], references: [id])
  naturezas        DespesaOperacionalNatureza[]

  @@index([planoTrabalhoId])
  @@index([omDestinoId])
  @@index([omCompradoraId])
  @@map("despesas_operacionais")
}

model DespesaOperacionalNatureza {
  id                   String             @id @default(cuid())
  despesaOperacionalId String             @map("despesa_operacional_id")
  naturezaId           String             @map("natureza_id")
  valor                Decimal            @db.Decimal(15, 2)
  despesaOperacional   DespesaOperacional @relation(fields: [despesaOperacionalId], references: [id], onDelete: Cascade)
  natureza             NaturezaDespesa    @relation(fields: [naturezaId], references: [id])

  @@unique([despesaOperacionalId, naturezaId])
  @@index([despesaOperacionalId])
  @@index([naturezaId])
  @@map("despesas_operacionais_naturezas")
}

model DocumentoReferencia {
  id              String        @id @default(cuid())
  nome            String
  tipo            String
  tamanhoKb       Int?          @map("tamanho_kb")
  observacao      String?
  planoTrabalhoId String        @map("plano_trabalho_id")
  uploadedById    String        @map("uploaded_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  planoTrabalho   PlanoTrabalho @relation(fields: [planoTrabalhoId], references: [id], onDelete: Cascade)
  uploadedBy      User          @relation(fields: [uploadedById], references: [id])

  @@index([planoTrabalhoId])
  @@map("documentos_referencia")
}

model NaturezaDespesa {
  id                   String                       @id @default(cuid())
  codigo               String                       @unique
  nome                 String
  descricao            String?
  gnd                  String                       @default("GND 3")
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")
  despesas             DespesaNatureza[]
  despesasOperacionais DespesaOperacionalNatureza[]

  @@index([codigo])
  @@map("naturezas_despesa")
}

model Operacao {
  id                         String             @id @default(cuid())
  nome                       String
  efetivoMil                 Int                @map("efetivo_mil")
  efetivoExt                 Int?               @map("efetivo_ext")
  dataInicio                 DateTime           @map("data_inicio")
  dataFinal                  DateTime           @map("data_final")
  diasTotais                 Int                @default(1) @map("dias_totais")
  status                     StatusPlano        @default(RASCUNHO)
  finalidade                 String?
  motivacao                  String?
  consequenciaNaoAtendimento String?            @map("consequencia_nao_atendimento")
  observacoes                String?
  omId                       String             @map("om_id")
  valorLimiteTotal           Decimal?           @map("valor_limite_total") @db.Decimal(15, 2)
  orgaoRequisitante          String?            @map("orgao_requisitante")
  responsavelDemanda         String?            @map("responsavel_demanda")
  emailResponsavel           String?            @map("email_responsavel")
  telefoneResponsavel        String?            @map("telefone_responsavel")
  dorNumero                  String?            @map("dor_numero")
  dorData                    DateTime?          @map("dor_data")
  createdAt                  DateTime           @default(now()) @map("created_at")
  updatedAt                  DateTime           @updatedAt @map("updated_at")
  auditoriaLogs              AuditoriaLog[]
  om                         OrganizacaoMilitar @relation(fields: [omId], references: [id])
  planosTrabalho             PlanoTrabalho[]
  omsParticipantes           OperacaoOM[]
  anexos                     AnexoOperacao[]

  @@index([dataFinal])
  @@index([dataInicio])
  @@index([omId])
  @@index([status])
  @@map("operacoes")
}

/** Documento assinado (PTrab ou DOR) anexado a uma Operação. Conteúdo salvo direto no banco — sem storage externo configurado no projeto. */
model AnexoOperacao {
  id           String   @id @default(cuid())
  operacaoId   String   @map("operacao_id")
  tipo         String
  nomeArquivo  String   @map("nome_arquivo")
  mimeType     String   @map("mime_type")
  tamanhoBytes Int      @map("tamanho_bytes")
  conteudo     Bytes
  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  operacao   Operacao @relation(fields: [operacaoId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])

  @@index([operacaoId, tipo])
  @@map("anexos_operacao")
}

model OperacaoOM {
  id              String              @id @default(cuid())
  operacaoId      String              @map("operacao_id")
  omId            String              @map("om_id")
  valorLimite     Decimal             @map("valor_limite") @db.Decimal(15, 2)
  omPaiOverrideId String?             @map("om_pai_override_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  operacao        Operacao            @relation(fields: [operacaoId], references: [id], onDelete: Cascade)
  om              OrganizacaoMilitar  @relation(fields: [omId], references: [id])
  omPaiOverride   OrganizacaoMilitar? @relation("OperacaoOMHierarchyOverride", fields: [omPaiOverrideId], references: [id])

  @@unique([operacaoId, omId])
  @@index([operacaoId])
  @@index([omId])
  @@index([omPaiOverrideId])
  @@map("operacao_om")
}

model OrganizacaoMilitar {
  id                             String               @id @default(cuid())
  nome                           String
  sigla                          String
  tipo                           TipoOM
  codUG                          String?              @unique @map("cod_ug")
  omPaiId                        String?              @map("om_pai_id")
  createdAt                      DateTime             @default(now()) @map("created_at")
  updatedAt                      DateTime             @updatedAt @map("updated_at")
  despesasOmDestino              DespesaOM[]          @relation("DespesaOMDestino")
  despesasOmCompradora           DespesaOM[]          @relation("DespesaOMCompradora")
  despesasOperacionaisDestino    DespesaOperacional[] @relation("DespesaOperacionalDestino")
  despesasOperacionaisCompradora DespesaOperacional[] @relation("DespesaOperacionalCompradora")
  operacoes                      Operacao[]
  operacoesParticipantes         OperacaoOM[]
  participacoesComoPaiOverride   OperacaoOM[]         @relation("OperacaoOMHierarchyOverride")
  planosTrabalho                 PlanoTrabalho[]
  itensRacaoR2                   ItemRacaoR2[]
  itensMunicao                   ItemMunicao[]
  omPai                          OrganizacaoMilitar?  @relation("OMHierarchy", fields: [omPaiId], references: [id], onDelete: Restrict)
  omsFilhas                      OrganizacaoMilitar[] @relation("OMHierarchy")
  users                          User[]
  aprovacoesHistorico            AprovacaoHistorico[]

  @@index([codUG])
  @@index([omPaiId])
  @@index([tipo])
  @@map("organizacoes_militares")
}

model PlanoTrabalho {
  id                   String                @id @default(cuid())
  titulo               String
  versao               Int                   @default(1)
  operacaoId           String                @map("operacao_id")
  omId                 String                @map("om_id")
  responsavelId        String                @map("responsavel_id")
  status               StatusPlano           @default(RASCUNHO)
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  tipo                 TipoPlano             @default(LOGISTICO)
  valorTotalDespesas   Decimal?              @default(0) @map("valor_total_despesas") @db.Decimal(15, 2)
  nivelAprovacaoAtual  Int?                  @map("nivel_aprovacao_atual")
  dataEnvioAnalise     DateTime?             @map("data_envio_analise")
  dataBloqueio         DateTime?             @map("data_bloqueio")
  importado            Boolean               @default(false)
  origemImportacao     String?               @map("origem_importacao")
  anotacoes            Anotacao[]
  aprovacoesHistorico  AprovacaoHistorico[]
  auditoriaLogs        AuditoriaLog[]
  despesas             Despesa[]
  despesasOperacionais DespesaOperacional[]
  documentosReferencia DocumentoReferencia[]
  itensRacaoR2         ItemRacaoR2[]
  itensMunicao         ItemMunicao[]
  operacao             Operacao              @relation(fields: [operacaoId], references: [id], onDelete: Cascade)
  om                   OrganizacaoMilitar    @relation(fields: [omId], references: [id])
  responsavel          User                  @relation(fields: [responsavelId], references: [id])

  @@index([operacaoId, omId, tipo])
  @@index([operacaoId])
  @@index([omId])
  @@index([responsavelId])
  @@index([status])
  @@index([tipo])
  @@map("planos_trabalho")
}

/** Linha de um Plano de Trabalho do tipo RACAO_R2: itens de ração sem rateio de valor em dinheiro, só quantidade. */
model ItemRacaoR2 {
  id              String             @id @default(cuid())
  planoTrabalhoId String             @map("plano_trabalho_id")
  omId            String             @map("om_id")
  item            String
  quantidade      Int
  memoria         String?            @db.Text
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  planoTrabalho   PlanoTrabalho      @relation(fields: [planoTrabalhoId], references: [id], onDelete: Cascade)
  om              OrganizacaoMilitar @relation(fields: [omId], references: [id])

  @@index([planoTrabalhoId])
  @@index([omId])
  @@map("itens_racao_r2")
}

/** Linha de um Plano de Trabalho do tipo MUNICAO: itens de munição sem rateio de valor em dinheiro, só quantidade. */
model ItemMunicao {
  id              String             @id @default(cuid())
  planoTrabalhoId String             @map("plano_trabalho_id")
  omId            String             @map("om_id")
  neeNsn          String             @map("nee_nsn")
  tipo            String
  quantidade      Int
  memoria         String?            @db.Text
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  planoTrabalho   PlanoTrabalho      @relation(fields: [planoTrabalhoId], references: [id], onDelete: Cascade)
  om              OrganizacaoMilitar @relation(fields: [omId], references: [id])

  @@index([planoTrabalhoId])
  @@index([omId])
  @@map("itens_municao")
}

/** Override de preço/custo de um item de catálogo logístico (armamento, viatura, kit de saúde, etc). Ausência de linha = usa o valor padrão hardcoded em src/lib/calculos. */
model ConfiguracaoPreco {
  id        String        @id @default(cuid())
  classe    ClasseDespesa
  grupo     String
  chave     String
  nome      String
  dados     Json
  updatedBy String?       @map("updated_by")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@unique([classe, grupo, chave])
  @@index([classe, grupo])
  @@map("configuracoes_preco")
}

/** Rascunho/modelo de despesa operacional configurado pelo admin em Configurações. Pré-preenche o formulário de Nova Despesa Operacional (GND 3/GND 4) — o usuário pode editar livremente depois de aplicado. */
model RascunhoDespesaOperacional {
  id             String   @id @default(cuid())
  gnd            String
  titulo         String
  objeto         String?
  objetivo       String?
  finalidade     String?
  memoriaCalculo String?  @map("memoria_calculo")
  ordem          Int      @default(0)
  updatedBy      String?  @map("updated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([gnd, titulo])
  @@index([gnd])
  @@map("rascunhos_despesa_operacional")
}

model Tipo {
  id               String    @id @default(cuid())
  nome             String
  classeId         String    @map("classe_id")
  isCombustivel    Boolean   @default(false)
  isCriavelUsuario Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  despesas         Despesa[]
  classe           Classe    @relation(fields: [classeId], references: [id], onDelete: Cascade)

  @@index([classeId])
  @@map("tipos")
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  passwordHash         String                @map("password_hash")
  nomeCompleto         String                @map("nome_completo")
  nomeGuerra           String?               @map("nome_guerra")
  postoGraduacao       String                @map("posto_graduacao")
  telefone             String?
  role                 Role
  isActive             Boolean               @default(true) @map("is_active")
  omId                 String                @map("om_id")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  anotacoes            Anotacao[]
  aprovacoesHistorico  AprovacaoHistorico[]
  auditoriaLogs        AuditoriaLog[]
  documentosReferencia DocumentoReferencia[]
  planosTrabalho       PlanoTrabalho[]
  artigosConsulta      ArtigoConsulta[]
  anexosOperacao       AnexoOperacao[]
  om                   OrganizacaoMilitar    @relation(fields: [omId], references: [id])

  @@index([email])
  @@index([omId])
  @@index([role])
  @@map("users")
}
